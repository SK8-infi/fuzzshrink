%% replication-style.sty
%% Reproduces the visual layout of a Springer journal article (as typeset in Annals of
%% Operations Research, 2026): page size, text block, fonts, sizes, spacing, running heads,
%% tables, captions and reference list. Measurements were taken from the published PDF.
%% It deliberately carries no journal branding (name, DOI, logo, dates or copyright line).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{replication-style}[2026/11/18 Springer-like article layout]

\RequirePackage{etoolbox}
%% ---------------------------------------------------------------- page and text block
%% Trim 155 x 235 mm; text block 345.8pt wide at 47.2pt from the left; 49 lines of 11.46pt.
\RequirePackage[paperwidth=439.37bp, paperheight=666.14bp,
  left=47.2bp, textwidth=345.8bp,
  top=55.8bp, textheight=559.5bp,
  headheight=10bp, asymmetric, headsep=14.4bp, footskip=21.7bp]{geometry}

%% ---------------------------------------------------------------- fonts
\RequirePackage[T1]{fontenc}
\RequirePackage{newtxtext}            % Times, as in the original body text
\RequirePackage{newtxmath}
\RequirePackage[lining,proportional]{sourcesans} % stands in for Myriad Pro (headings, labels)
\newcommand*\SSm{\fontfamily{SourceSansThree-LF}\fontseries{m}\selectfont}
\newcommand*\SSsb{\fontfamily{SourceSansThree-LF}\fontseries{sb}\selectfont}
\newcommand*\SSb{\fontfamily{SourceSansThree-LF}\fontseries{b}\selectfont}
\RequirePackage{microtype}
\RequirePackage{marvosym}             % envelope symbol for the corresponding author

%% Body 9.46/11.46pt; small 7.97/9.2pt (headers, captions, tables, references, footnotes)
\renewcommand\normalsize{\fontsize{9.46bp}{11.46bp}\selectfont
  \abovedisplayskip 8pt plus 2pt minus 4pt \belowdisplayskip \abovedisplayskip
  \abovedisplayshortskip 0pt plus 2pt \belowdisplayshortskip 5pt plus 2pt minus 2pt}
\renewcommand\small{\fontsize{7.97bp}{9.2bp}\selectfont}
\renewcommand\footnotesize{\fontsize{7.97bp}{9.2bp}\selectfont}
\normalsize
\setlength\topskip{9.46bp}
\setlength\parindent{11.3bp}
\setlength\parskip{0pt}
\flushbottom

%% ---------------------------------------------------------------- colours and links
\RequirePackage{xcolor}
\definecolor{labelgrey}{rgb}{0.765,0.769,0.769}
\RequirePackage[colorlinks=true, linkcolor=blue, citecolor=blue, urlcolor=blue]{hyperref}
\urlstyle{same}

%% ---------------------------------------------------------------- section headings
\RequirePackage{titlesec}
\titleformat{\section}{\SSb\fontsize{10.96bp}{13bp}\selectfont}{\thesection}{0.42em}{}
\titleformat{\subsection}{\SSb\fontsize{9.96bp}{12bp}\selectfont}{\thesubsection}{0.42em}{}
\titlespacing*{\section}{0pt}{18.8bp plus 2bp minus 1bp}{10.6bp}
\titlespacing*{\subsection}{0pt}{16.3bp plus 2bp minus 1bp}{11.2bp}

%% ---------------------------------------------------------------- running heads and folios
\RequirePackage{fancyhdr}
\newcommand*\runningtitle{}
\newcommand*\headrulebox{\rlap{\raisebox{-6.7bp}{\rule{\textwidth}{1bp}}}}
\fancypagestyle{article}{%
  \fancyhf{}%
  \renewcommand\headrulewidth{0pt}%
  \fancyhead[LO]{\headrulebox{\SSm\small\runningtitle}}%
  \fancyhead[LE]{\headrulebox{}}%
  \fancyhead[RE]{\SSm\small\runningtitle}%
  \fancyfoot[RO,LE]{\SSm\fontsize{8.5bp}{10bp}\selectfont\thepage}}
\newcommand*\firstpageline{}
\newcommand*\firstpagelinetwo{}
\fancypagestyle{firstpage}{%
  \fancyhf{}%
  \renewcommand\headrulewidth{0pt}%
  \fancyhead[L]{\SSm\small\rlap{\raisebox{-2bp}{\firstpageline}}\rlap{\raisebox{-11.3bp}{\firstpagelinetwo}}}%
  \fancyfoot[R]{\SSm\fontsize{8.5bp}{10bp}\selectfont\thepage}}
\pagestyle{article}

%% ---------------------------------------------------------------- title block
\newcommand*\articletype{}
\newcommand*\articletitle{}
\newcommand*\articleauthors{}
\newcommand*\versionlineone{}
\newcommand*\versionlinetwo{}
\newcommand\articleabstract{}
\newcommand*\articlekeywords{}
\newcommand*\kwsep{\unskip~$\cdot$ \ignorespaces}
\newcommand\maketitlepage{%
  \thispagestyle{firstpage}%
  % One box of height \topskip at the very top of the text block holds the rule and the label bar,
  % so LaTeX adds no \topskip above them (rule centred 1.5bp below the block top, bar under it).
  \noindent\vbox to \topskip{\vskip 1bp\hrule height 1bp width \textwidth
    \kern -0.1bp
    \hbox{\setlength\fboxsep{0pt}\colorbox{labelgrey}{\makebox[226.8bp][l]{\hspace*{2.3bp}%
      \raisebox{1.3bp}[7.5bp][2.9bp]{\SSsb\small\textls[200]{\MakeUppercase{\articletype}}}}}}%
    \vss}\par
  \nointerlineskip\vskip 27.4bp
  {\raggedright\SSsb\fontsize{12.95bp}{14.9bp}\selectfont
   \parbox[t]{0.8\textwidth}{\raggedright\articletitle}\par}%
  \vskip 14.0bp
  {\raggedright\SSsb\normalsize\articleauthors\par}%
  \vskip 15.6bp
  {\raggedright\SSm\small\versionlineone\par\versionlinetwo\par}%
  \vskip 20.8bp
  {\noindent\SSb Abstract\par}%
  \vskip -0.1bp
  {\noindent\articleabstract\par}%
  \vskip 11bp
  {\raggedright\noindent{\SSsb Keywords}\hspace{4.6bp}\articlekeywords\par}%
  \vskip 3.4bp}
%% guard for \addfontfeature when fontspec is not loaded
\providecommand*\addfontfeature[1]{}

%% Author superscripts and the first-page footnote block
\newcommand*\aff[1]{\textsuperscript{\SSsb\fontsize{7.19bp}{8bp}\selectfont #1}}
\renewcommand\footnoterule{\kern-3pt\hrule width 107.7pt height 0.57pt\kern 7.4pt}
\setlength{\skip\footins}{12bp plus 4bp minus 3bp}
\newcommand\firstpagenotes[1]{{\let\thefootnote\relax\footnotetext{#1}}}
\newcommand\noteline[2]{\par\noindent\hbox to 14.2pt{#1\hss}\parbox[t]{\dimexpr\textwidth-14.2pt}{\raggedright #2}\par}

%% ---------------------------------------------------------------- tables and figures
\RequirePackage{booktabs}
\setlength\heavyrulewidth{1pt}
\setlength\lightrulewidth{0.41pt}
\setlength\cmidrulewidth{0.41pt}
\setlength\aboverulesep{2.9bp}
\setlength\belowrulesep{6.1bp}
\let\botrule\bottomrule
\newcommand\tabletoprule{\toprule\addlinespace[3.0bp]}
\newcommand\tabhead[1]{{\renewcommand\arraystretch{1}\begin{tabular}[t]{@{}l@{}}#1\end{tabular}}}
% Floats reset the font to \normalsize, so the table size is set inside the tabular itself.
\AtBeginEnvironment{tabular*}{\small\renewcommand\arraystretch{1.36}\setlength\tabcolsep{2pt}}
\RequirePackage{caption}
\DeclareCaptionLabelFormat{sb}{{\SSsb #1~#2}}
\captionsetup{font=small, labelformat=sb, labelsep=space, justification=raggedright,
  singlelinecheck=false, skip=6pt}
\captionsetup[figure]{name=Fig., skip=8pt}
\captionsetup[table]{position=top, skip=2.9bp}
\setlength\textfloatsep{18pt plus 4pt minus 2pt}
\setlength\intextsep{16pt plus 4pt minus 2pt}
\setlength\floatsep{16pt plus 4pt minus 2pt}

%% ---------------------------------------------------------------- back matter (sn-jnl names)
\newcommand\backmatter{}
\newcommand\bmhead[1]{\par\addvspace{4pt}\noindent{\SSsb #1}\enspace\ignorespaces}

%% ---------------------------------------------------------------- references (APA 7)
\RequirePackage[american]{babel}
\RequirePackage{csquotes}
\RequirePackage[style=apa, backend=biber, natbib=true, doi=true, url=false]{biblatex}
\renewcommand*{\bibfont}{\small}
\setlength{\bibhang}{17pt}
\setlength{\bibitemsep}{0pt}
\setlength{\bibparsep}{0pt}
\endinput
